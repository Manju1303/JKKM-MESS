generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId Int
  @@unique([roleId, permissionId])
}

model User {
  id                  Int            @id @default(autoincrement())
  name                String
  email               String         @unique
  phone               String?
  password            String
  role                Role           @relation(fields: [roleId], references: [id])
  roleId              Int
  isActive            Boolean        @default(true)
  lastLogin           DateTime?
  failedLoginAttempts Int            @default(0)
  lockUntil           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  auditLogs           AuditLog[]
  purchases           Purchase[]
  kitchenIssues       DailyIssue[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  type        String    // PACKAGED, VEGETABLE, BULK
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  code           String?         @unique
  barcode        String?         @unique
  category       Category        @relation(fields: [categoryId], references: [id])
  categoryId     Int
  type           String          // PACKAGED, VEGETABLE, BULK
  unit           String          // KG, LITRE, PIECE, PACKET, etc.
  unitSize       Float?          // e.g. 1, 0.5, 5
  minStockLevel  Float           @default(0)
  maxStockLevel  Float?
  imageUrl       String?
  isActive       Boolean         @default(true)
  inventories    Inventory[]
  purchaseItems  PurchaseItem[]
  dailyIssues    DailyIssue[]
  wastage        Wastage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Supplier {
  id            Int        @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String
  email         String?
  address       String?
  gstNumber     String?
  panNumber     String?
  bankAccount   String?
  bankIfsc      String?
  isActive      Boolean    @default(true)
  purchases     Purchase[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Inventory {
  id                Int       @id @default(autoincrement())
  product           Product   @relation(fields: [productId], references: [id])
  productId         Int
  batchNumber       String?
  quantity          Float
  unit              String
  costPerUnit       Float
  expiryDate        DateTime?
  manufacturingDate DateTime?
  location          String?   @default("Main Store")
  isExpired         Boolean   @default(false)
  isNearExpiry      Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  movements         StockMovement[]

  @@index([productId, isExpired, quantity])
  @@index([expiryDate])
}

model StockMovement {
  id          Int       @id @default(autoincrement())
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  inventoryId Int
  type        String    // IN, OUT, ADJUSTMENT, WASTE
  quantity    Float
  reason      String?
  reference   String?
  createdAt   DateTime  @default(now())
}

model Purchase {
  id             Int            @id @default(autoincrement())
  purchaseNumber String         @unique
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  supplierId     Int
  purchaseDate   DateTime
  totalAmount    Float
  gstAmount      Float          @default(0)
  netAmount      Float
  billNumber     String?
  billUrl        String?
  status         String         @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy     Int?
  approvedAt     DateTime?
  notes          String?
  createdBy      User           @relation(fields: [createdById], references: [id])
  createdById    Int
  items          PurchaseItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([purchaseDate])
}

model PurchaseItem {
  id          Int      @id @default(autoincrement())
  purchase    Purchase @relation(fields: [purchaseId], references: [id])
  purchaseId  Int
  product     Product  @relation(fields: [productId], references: [id])
  productId   Int
  quantity    Float
  unit        String
  unitPrice   Float
  totalPrice  Float
  gstPercent  Float    @default(0)
  batchNumber String?
  expiryDate  DateTime?
}

model DailyIssue {
  id          Int      @id @default(autoincrement())
  issueDate   DateTime
  product     Product  @relation(fields: [productId], references: [id])
  productId   Int
  quantity    Float
  unit        String
  meal        String   // BREAKFAST, LUNCH, DINNER, SNACK
  issuedBy    User     @relation(fields: [issuedById], references: [id])
  issuedById  Int
  notes       String?
  createdAt   DateTime @default(now())
  consumptionLogs ConsumptionLog[]

  @@index([issueDate])
}

model ConsumptionLog {
  id           Int        @id @default(autoincrement())
  dailyIssue   DailyIssue @relation(fields: [dailyIssueId], references: [id])
  dailyIssueId Int
  date         DateTime
  productId    Int
  quantity     Float
  unit         String
  meal         String
  headcount    Int        @default(0)
  perHeadUsage Float?
  createdAt    DateTime   @default(now())

  @@index([date, productId])
}

model Wastage {
  id          Int      @id @default(autoincrement())
  product     Product  @relation(fields: [productId], references: [id])
  productId   Int
  quantity    Float
  unit        String
  reason      String   // EXPIRED, DAMAGED, OVERCOOK, OTHER
  valueAmount Float
  reportedAt  DateTime
  notes       String?
  createdAt   DateTime @default(now())

  @@index([reportedAt])
  @@index([productId, reportedAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String   // LOW_STOCK, EXPIRY, PURCHASE, SYSTEM
  severity  String   @default("INFO") // INFO, WARNING, CRITICAL
  isRead    Boolean  @default(false)
  userId    Int?
  createdAt DateTime @default(now())
}

model Report {
  id          Int      @id @default(autoincrement())
  type        String   // DAILY, WEEKLY, MONTHLY, CUSTOM
  title       String
  dateFrom    DateTime
  dateTo      DateTime
  fileUrl     String?
  format      String   // PDF, EXCEL, CSV
  generatedBy Int
  createdAt   DateTime @default(now())
}

model Attendance {
  id        Int      @id @default(autoincrement())
  date      DateTime
  meal      String   // BREAKFAST, LUNCH, DINNER
  count     Int
  hostel    String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([date])
  @@index([meal, date])
}

model Menu {
  id        Int      @id @default(autoincrement())
  date      DateTime
  meal      String
  items     String   // JSON array of menu items
  notes     String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  action    String
  entity    String
  entityId  Int?
  oldData   String?  // JSON
  newData   String?  // JSON
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model LoginActivity {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String
  status    String   // SUCCESS, FAILED
  ipAddress String?
  device    String?  // Parsed device info / User-Agent
  timestamp DateTime @default(now())

  @@index([email])
  @@index([timestamp])
  @@index([userId, timestamp])
}

model Complaint {
  id          Int       @id @default(autoincrement())
  studentId   Int
  studentName String
  title       String
  description String
  status      String    @default("PENDING") // PENDING, RESOLVED
  resolvedBy  Int?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
